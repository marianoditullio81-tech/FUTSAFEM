rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil de jugadoras y cuerpo técnico: solo la propia usuaria sube su foto.
    // La lectura es pública (necesaria para mostrar figuritas a otras usuarias).
    match /fotos_perfil/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
