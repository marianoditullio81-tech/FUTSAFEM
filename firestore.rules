rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function esAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    // users: cada usuaria lee y escribe solo su propio documento.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // El voto social de fotos: cualquier usuaria puede mover una foto de
      // "en_revision" a "aprobada"/"rechazada_revision" sin tocar fotoUrl.
      // Solo la admin puede confirmar un rechazo y recién ahí se borra la foto.
      allow update: if isOwner(userId) ||
        (isSignedIn() &&
         resource.data.estadoFoto == 'en_revision' &&
         request.resource.data.estadoFoto in ['en_revision', 'aprobada', 'rechazada_revision'] &&
         request.resource.data.fotoUrl == resource.data.fotoUrl &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['votosFotoAprobar', 'votosFotoRechazar', 'estadoFoto'])) ||
        esAdmin();
      allow delete: if false;
    }

    // votosFoto: un voto por par (foto evaluada, votante). El id del
    // documento fuerza unicidad y evita votar dos veces la misma foto.
    match /votosFoto/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.voterUid == request.auth.uid &&
        request.resource.data.targetUid != request.auth.uid &&
        voteId == request.resource.data.targetUid + '_' + request.resource.data.voterUid;
      allow update: if false;
      allow delete: if false;
    }

    // clubs, players, stickers: catálogo de lectura pública.
    // La escritura queda para el panel de admin (fase 2).
    // clubs es legible sin sesión porque los formularios de registro
    // necesitan listar los clubes antes de que la usuaria se autentique.
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // config: parámetros globales editables por la admin (ej. probabilidades
    // de sobres). Lectura abierta a usuarias logueadas porque el cliente la
    // necesita para abrir sobres sin Cloud Functions.
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if esAdmin();
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow write: if esAdmin();
    }

    // sponsors: logos/links de marcas auspiciantes (sin pago real, Etapa
    // 3-A). Lectura pública (se muestran también en la pantalla de
    // bienvenida, antes del login), escritura solo admin.
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /stickers/{stickerId} {
      allow read: if isSignedIn();
      allow write: if esAdmin();
    }

    // userCollection: cada usuaria gestiona solo sus propias figuritas.
    // Las repetidas (cantidad > 1) son visibles para todas: alimentan el mercado de pases.
    match /userCollection/{entryId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || resource.data.cantidad > 1);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // trades: visibles y editables solo por las dos usuarias involucradas.
    match /trades/{tradeId} {
      allow read: if isSignedIn() &&
        (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if isSignedIn() &&
        (request.resource.data.userA == request.auth.uid || request.resource.data.userB == request.auth.uid);
      allow update: if isSignedIn() &&
        (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow delete: if false;
    }

    // swipes: cada usuaria solo crea/lee sus propios swipes.
    match /swipes/{swipeId} {
      allow read: if isSignedIn() && resource.data.swiperId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.swiperId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // mensajesTribuna: muro general (clubId == "") y muros por club.
    // Cualquier usuaria logueada lee y escribe a nombre propio; sin edición ni borrado salvo admin.
    match /mensajesTribuna/{mensajeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.texto.size() > 0 &&
        request.resource.data.texto.size() <= 280;
      allow update: if false;
      allow delete: if esAdmin();
    }

    // notificaciones: cada usuaria solo ve y marca como leídas las suyas.
    // La creación la hace cualquier usuaria logueada (acciones cliente: voto de
    // foto, match, admin) a nombre de la destinataria, sin Cloud Functions.
    match /notificaciones/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if false;
    }

    // packsLog: historial de sobres abiertos, cada usuaria solo ve y crea el suyo.
    match /packsLog/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // avisosCumple: marca de "ya se generó el saludo de cumpleaños de esta
    // usuaria hoy" (id determinístico cumple_{userId}_{fecha}). Cualquier
    // usuaria logueada puede crear la marca al detectar el cumpleaños; si dos
    // usuarias abren la app a la vez, la segunda escritura recae sobre un
    // documento que ya existe (se trata como "update") y queda bloqueada,
    // evitando duplicar el aviso.
    match /avisosCumple/{marcaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // codigosReferido: maps a 6-char code to the user's uid + nombre.
    // Any signed-in user can read (needed to resolve a referrer at registration).
    // Only the owner can create their own entry (via registrarUsuaria which runs as the new user).
    match /codigosReferido/{codigo} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // referidos: one doc per (invitadora, invitada) pair. Deterministic ID prevents duplicates.
    // The invitada updates only the emailVerificado flag (after email is confirmed on home load).
    match /referidos/{refId} {
      allow read: if isSignedIn() &&
        (resource.data.invitadoraId == request.auth.uid || resource.data.invitadaId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.invitadaId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerificado']);
      allow delete: if false;
    }

    // premiosPendientes: async reward queue. Any signed-in user can create (to credit another user).
    // Only the recipient can mark acreditado=true (self-collection pattern).
    match /premiosPendientes/{premioId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acreditado']);
      allow delete: if false;
    }
  }
}
